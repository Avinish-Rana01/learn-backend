# DevLearn Backend Environment Variables
# Step 3 Foundation — Authentication & Sessions

# Server Configuration
PORT=4000
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# PostgreSQL Database Connection (Prisma)
# Replace with your PostgreSQL connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/devlearn_db?schema=public

# Security & Session Secrets
# Replace with a cryptographically secure random 64-character secret in production
JWT_SECRET=devlearn-dev-jwt-secret-change-in-production
