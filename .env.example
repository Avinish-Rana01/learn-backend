# ==========================================
# Learn Platform - Backend Configuration
# ==========================================

# Server Port & Environment
PORT=4000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection
# If DATABASE_URL is left empty, the backend uses embedded PostgreSQL (PGlite) for zero-config local development.
# For production PostgreSQL, provide a standard connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/learn_db
DATABASE_URL=

# Security & Session Secrets
# Replace with 64-character random cryptographically secure keys in production
JWT_SECRET=your_super_secret_jwt_access_key_replace_in_production
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_replace_in_production
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
